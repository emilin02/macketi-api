ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (orígenes permitidos)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=Macketi API